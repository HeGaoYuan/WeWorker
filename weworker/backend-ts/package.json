    "@napi-rs/keyring": "^1.3.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "express": "^4.19.2",
    "node-cron": "^4.2.1",
    "sm-crypto": "^0.4.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.12",
    "fast-check": "^4.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
